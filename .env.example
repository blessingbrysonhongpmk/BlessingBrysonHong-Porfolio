# ─────────────────────────────────────────────────────────────
# BBH Portfolio — Environment Variables
# 1. Copy this file to .env in the same directory.
# 2. Fill in real values from your Firebase console.
# 3. NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Firebase Config (required) ────────────────────────────────
# Find these in: Firebase Console → Project Settings → Your Apps → Web App
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Contact form (optional — falls back to mailto if not set) ─
VITE_CONTACT_FORM_ENDPOINT=

# ── Analytics (optional) ─────────────────────────────────────
VITE_GA_MEASUREMENT_ID=

# ── Site URL (used for meta tags in production) ───────────────
VITE_SITE_URL=https://blessingbrysonhong.vercel.app
