# ─────────────────────────────────────────────
# BBH Portfolio — Environment Variables
# Copy to .env and fill in values.
# Never commit .env to version control.
# ─────────────────────────────────────────────

# Contact form (optional — falls back to mailto if not set)
VITE_CONTACT_FORM_ENDPOINT=

# Analytics (optional)
VITE_GA_MEASUREMENT_ID=

# Site URL (used for meta tags in production)
VITE_SITE_URL=https://blessingbrysonhong.vercel.app
